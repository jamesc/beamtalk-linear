/// Issue — a normalized Linear issue, built from a GraphQL issue node.
typed Value subclass: Issue
  uses: JsonMappable
  field: id :: String | Nil = nil
  field: identifier :: String | Nil = nil
  field: title :: String | Nil = nil
  field: description :: String | Nil = nil
  field: priority :: Integer | Nil = nil
  field: state :: String | Nil = nil
  field: branchName :: String | Nil = nil
  field: url :: String | Nil = nil
  field: labels :: List(String) = #()
  field: blockedBy :: List(IssueRef) = #()
  field: createdAt :: String | Nil = nil
  field: updatedAt :: String | Nil = nil

  /// Builds an Issue from a Linear GraphQL issue node.
  class fromNode: node :: Dictionary -> Issue =>
    #{
      ?"id" => id,
      ?"identifier" => identifier,
      ?"title" => title,
      ?"description" => description,
      ?"priority" => rawPriority,
      ?"state" => stateNode,
      ?"branchName" => branchName,
      ?"url" => url,
      ?"labels" => labelsObj,
      ?"inverseRelations" => relationsObj,
      ?"createdAt" => createdAt,
      ?"updatedAt" => updatedAt
    } := node
    // `state` may be absent, null, or a node without `name`.
    state := stateNode match: [
      #{?"name" => name} -> name;
      _ -> nil
    ]
    priority := rawPriority match: [
      n :: Integer -> n;
      _ -> nil
    ]
    self
      new: #{
        #id => id,
        #identifier => identifier,
        #title => title,
        #description => description,
        #priority => priority,
        #state => state,
        #branchName => branchName,
        #url => url,
        #labels => (self labelsFromNode: labelsObj),
        #blockedBy => (self blockersFromNode: relationsObj),
        #createdAt => createdAt,
        #updatedAt => updatedAt
      }

  class labelsFromNode: labelsObj :: Dictionary | Nil -> List(String) =>
    labelsObj isNil ifTrue: [^#()]
    nodes := labelsObj at: "nodes" ifAbsent: [#()]
    nodes collect: [:l | (l at: "name" ifAbsent: [""]) lowercase]

  class blockersFromNode: relationsObj :: Dictionary | Nil -> List(IssueRef) =>
    relationsObj isNil ifTrue: [^#()]
    nodes := relationsObj at: "nodes" ifAbsent: [#()]
    // Only include inverse relations of type "blocks"
    blockers := nodes select: [:r | (r at: "type" ifAbsent: [""]) == "blocks"]
    blockers collect: [:r |
      IssueRef fromNode: (r at: "relatedIssue" ifAbsent: [#{}])
    ]

  /// Wire-format schema (JsonMappable, BT-2819): camelCase fields map to
  /// snake_case keys. `asJson` is derived and still answers a Dictionary, so
  /// downstream template lookup keeps working. `blockedBy` holds IssueRefs,
  /// which are mapped objects and convert recursively.
  class jsonMapping -> JsonMapping =>
    JsonMapping new
      |> mapField: #id
      |> mapField: #identifier
      |> mapField: #title
      |> mapField: #description
      |> mapField: #priority
      |> mapField: #state
      |> mapField: #branchName to: "branch_name"
      |> mapField: #url
      |> mapField: #labels
      |> mapField: #blockedBy to: "blocked_by"
      |> mapField: #createdAt to: "created_at"
      |> mapField: #updatedAt to: "updated_at"
